{
  "expo": {
    "name": "Ajudaê!",
    "slug": "ajuda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ajuda",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF5500"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajuda.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBqvnNAAs_wdQ00HwdnqgmZ73kHO8uBny8"
      }
    },
    "android": {
      "package": "com.ajuda.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBqvnNAAs_wdQ00HwdnqgmZ73kHO8uBny8"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "58679028-d339-4d8d-9fde-bd7dd1ad7725"
      }
    },
    "owner": "juiceluqi"
  }
}
